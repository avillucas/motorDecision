{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "bot-flow": ["packages/bot-flow/src"],
      "bot-flow/*": ["packages/bot-flow/src/*"]
    }
  },
  "include": ["packages/**/*", "services/**/*"],
  "references": [
    { "path": "packages/bot-flow" },
    { "path": "services/whatsapp-adapter" }
  ]
}

#!/bin/bash
# Script to run the interactive chat mockup inside Docker

# Ensure container is running
CONTAINER_STATE=$(docker compose ps --status running -q dev 2>/dev/null)
if [ -z "$CONTAINER_STATE" ]; then
    echo "Starting development environment (Docker)..."
    docker compose up -d dev
fi

echo "Starting interactive mockup (Console)..."
docker compose exec -e INTERFACE_TYPE=console -e LEAD_REPO_TYPE=csv -it dev npm start

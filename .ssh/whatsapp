#!/bin/bash
# Script para iniciar y correr el Bot de WhatsApp dentro del contenedor Docker

# 1. Aseguramos que el contenedor esté corriendo
CONTAINER_STATE=$(docker compose ps --status running -q dev 2>/dev/null)
if [ -z "$CONTAINER_STATE" ]; then
    echo "Iniciando el entorno de desarrollo (Docker)..."
    docker compose up -d dev
fi

# 2. Instalamos las dependencias dentro del contenedor si es necesario
# Como añadimos Baileys y otras librerías, es importante hacer npm install
echo "Verificando dependencias dentro del contenedor..."
docker compose exec dev npm install

# 3. Ejecutamos el bot (pasando las variables de entorno para usar WhatsApp y CSV)
echo "Iniciando el Bot de WhatsApp..."
docker compose exec -e INTERFACE_TYPE=whatsapp -e LEAD_REPO_TYPE=csv -it dev npm start
